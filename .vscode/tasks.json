{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start DM Panel",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^",
          "endsPattern": "listening on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dm-panel"
      },
      "runOptions": {
        "runOn": "default"
      }
    }
  ]
}
