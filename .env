# Imgur API Configuration
# Get these from: https://api.imgur.com/oauth2/addclient
# For account-specific uploads, use ACCESS_TOKEN from https://imgur.com/account/settings/apps

# Anonymous upload (client_id only)
IMGUR_CLIENT_ID=your_client_id_here

# Authenticated upload (requires OAuth2 token)
# Generate at: https://imgur.com/account/settings/apps
IMGUR_ACCESS_TOKEN=your_access_token_here

# Legacy credentials (provided by Board)
IMGUR_USERNAME=ej.hitchcock@gmail.com
IMGUR_PASSWORD=blabbermouth
